aws_region        = "ap-south-1"
environment       = "production"
github_repository = "YOUR_GITHUB_OWNER/YOUR_REPOSITORY"
cluster_admin_cidrs = ["YOUR_PUBLIC_IP/32"]

# Change only when you have verified the selected version and instance class in your region.
kubernetes_version       = "1.34"
node_instance_type       = "t3.large"
node_min_size            = 2
node_max_size            = 4
postgres_instance_class  = "db.t4g.micro"
postgres_multi_az        = false

# Set these after infrastructure outputs reveal the CloudFront URL and after a Google-owned domain is available.
app_origin              = "https://localhost"
google_client_id        = ""
cloudfront_alb_dns_name = ""
